{
  "area": "get-balance",
  "name": "get-balance-protocol-error-balance-string",
  "description": "A balance sent as a string is a ProtocolError.",
  "evidence": [
    "contract:docs/design.md §3 Errors"
  ],
  "script": [
    {
      "expect": {
        "method": "POST",
        "path": "/getBalance",
        "json": {
          "clientKey": "sur_00000000000000000000000000000000"
        },
        "noQuery": true
      },
      "respond": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "no-store"
        },
        "json": {
          "errorId": 0,
          "balance": "9.987"
        }
      }
    }
  ],
  "call": {
    "method": "getBalance"
  },
  "expect": {
    "sleeps": [],
    "outcome": {
      "error": {
        "operation": "getBalance",
        "type": "ProtocolError"
      }
    }
  }
}
