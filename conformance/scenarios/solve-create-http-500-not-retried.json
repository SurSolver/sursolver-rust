{
  "area": "solve",
  "name": "solve-create-http-500-not-retried",
  "description": "HTTP 500 on createTask is surfaced at once and never resubmitted.",
  "evidence": [
    "contract:docs/design.md §3 solve() semantics",
    "contract:docs/contract.md §5 charging and retry safety"
  ],
  "script": [
    {
      "expect": {
        "method": "POST",
        "path": "/createTask",
        "json": {
          "clientKey": "sur_00000000000000000000000000000000",
          "task": {
            "type": "TurnstileTokenProxyLess",
            "websiteURL": "https://example.com/login",
            "websiteKey": "0x4AAAAAAAexample",
            "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36"
          }
        },
        "noQuery": true
      },
      "respond": {
        "status": 500,
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "success": false,
          "error": {
            "code": "internal_error",
            "message": "Internal server error."
          }
        }
      }
    }
  ],
  "call": {
    "method": "solve",
    "args": {
      "task": {
        "type": "TurnstileTokenProxyLess",
        "websiteURL": "https://example.com/login",
        "websiteKey": "0x4AAAAAAAexample",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36"
      }
    }
  },
  "expect": {
    "sleeps": [],
    "outcome": {
      "error": {
        "type": "TransportError",
        "operation": "createTask",
        "status": 500,
        "mayHaveCreatedTask": true
      }
    }
  }
