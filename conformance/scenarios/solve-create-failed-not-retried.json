{
  "area": "solve",
  "name": "solve-create-failed-not-retried",
  "description": "ERROR_FAILED on submit means no task exists: solve() ends at once with a plain ApiError, never TaskFailedError.",
  "evidence": [
    "contract:docs/design.md §3 solve() semantics",
    "contract:docs/contract.md §4 error-code table",
    "contract:docs/contract.md §5 charging and retry safety"
  ],
  "script": [
    {
      "expect": {
        "method": "POST",
        "path": "/createTask",
        "json": {
          "clientKey": "sur_00000000000000000000000000000000",
          "task": {
            "type": "TurnstileTokenProxyLess",
            "websiteURL": "https://example.com/login",
            "websiteKey": "0x4AAAAAAAexample",
            "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36"
          }
        },
        "noQuery": true
      },
      "respond": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "no-store"
        },
        "json": {
          "errorId": 1,
          "errorCode": "ERROR_FAILED",
          "errorDescription": "Payments are disabled."
        }
      }
    }
  ],
  "call": {
    "method": "solve",
    "args": {
      "task": {
        "type": "TurnstileTokenProxyLess",
        "websiteURL": "https://example.com/login",
        "websiteKey": "0x4AAAAAAAexample",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36"
      }
    }
  },
  "expect": {
    "sleeps": [],
    "outcome": {
      "error": {
        "type": "ApiError",
        "operation": "createTask",
        "code": "ERROR_FAILED",
        "retryable": false
      }
    }
  }
}
