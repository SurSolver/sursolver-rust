{
  "area": "security",
  "name": "security-key-only-in-body-and-url-clean",
  "description": "The key travels only in the JSON body field clientKey: no query string, no auth or x-api-key header.",
  "evidence": [
    "contract:docs/contract.md §9 never echo the clientKey",
    "contract:docs/contract.md §2.1 createTask"
  ],
  "script": [
    {
      "expect": {
        "method": "POST",
        "path": "/createTask",
        "json": {
          "clientKey": "sur_00000000000000000000000000000000",
          "task": {
            "type": "TurnstileTokenProxyLess",
            "websiteURL": "https://example.com/login",
            "websiteKey": "0x4AAAAAAAexample",
            "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36"
          }
        },
        "noQuery": true
      },
      "respond": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "no-store"
        },
        "json": {
          "errorId": 0,
          "taskId": "tsk_4f7a9c1e2b8d3a6f5c0e9d21",
          "status": "idle"
        }
      }
    }
  ],
  "call": {
    "method": "createTask",
    "args": {
      "task": {
        "type": "TurnstileTokenProxyLess",
        "websiteURL": "https://example.com/login",
        "websiteKey": "0x4AAAAAAAexample",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36"
      }
    }
  },
  "expect": {
    "sleeps": [],
    "redaction": true,
    "outcome": {
      "ok": "tsk_4f7a9c1e2b8d3a6f5c0e9d21"
    }
  }
}
