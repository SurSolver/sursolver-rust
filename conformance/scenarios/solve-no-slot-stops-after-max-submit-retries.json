          }
        },
        "noQuery": true
      },
      "respond": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "no-store"
        },
        "json": {
          "errorId": 1,
          "errorCode": "ERROR_NO_SLOT_AVAILABLE",
