{
  "area": "task-types",
  "name": "task-types-protocol-error-entry-field-mistyped",
  "description": "A catalog entry whose field has the wrong type is a ProtocolError, never a half-filled model.",
  "evidence": [
    "contract:docs/contract.md §2.4",
    "contract:docs/design.md §3 Errors"
  ],
  "script": [
    {
      "expect": {
        "method": "GET",
        "path": "/v1/task-types",
        "noQuery": true
      },
      "respond": {
        "status": 200,
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "success": true,
          "data": {
            "task_types": [
              {
                "page_slug": null,
                "display_name": "Castle Web",
                "task_type": "CastleWebToken",
                "task_type_proxyless": null,
                "aliases": [
                  "CastleToken"
                ],
                "proxy": "none",
                "required": "websiteURL",
                "any_of": [],
                "optional": [],
                "solution_keys": [
                  "token"
                ]
              }
            ],
            "error_codes": [
              "ERROR_FAILED"
            ]
          }
        }
      }
    }
  ],
  "call": {
    "method": "listTaskTypes"
  },
  "expect": {
    "outcome": {
      "error": {
        "type": "ProtocolError",
        "operation": "listTaskTypes"
      }
    }
  }
}
