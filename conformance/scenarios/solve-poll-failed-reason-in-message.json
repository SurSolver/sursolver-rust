{
  "area": "solve",
  "name": "solve-poll-failed-reason-in-message",
  "description": "ERROR_FAILED on the first poll ends solve() with TaskFailedError whose message carries the code, the API reason and the task id.",
  "evidence": [
    "contract:docs/design.md §3 solve() semantics",
    "contract:docs/contract.md §2.2 getTaskResult",
    "contract:docs/contract.md §4 error-code table"
  ],
  "script": [
    {
      "expect": {
        "method": "POST",
        "path": "/createTask",
        "json": {
          "clientKey": "sur_00000000000000000000000000000000",
          "task": {
            "type": "TurnstileTokenProxyLess",
            "websiteURL": "https://example.com/login",
            "websiteKey": "0x4AAAAAAAexample",
            "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36"
          }
        },
        "noQuery": true
      },
      "respond": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "no-store"
        },
        "json": {
          "errorId": 0,
          "taskId": "tsk_4f7a9c1e2b8d3a6f5c0e9d21",
          "status": "idle"
        }
      }
    },
    {
      "expect": {
        "method": "POST",
        "path": "/getTaskResult",
        "json": {
          "clientKey": "sur_00000000000000000000000000000000",
          "taskId": "tsk_4f7a9c1e2b8d3a6f5c0e9d21"
        },
        "noQuery": true
      },
      "respond": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "no-store"
        },
        "json": {
          "errorId": 1,
          "errorCode": "ERROR_FAILED",
          "errorDescription": "Captcha could not be solved."
        }
      }
    }
  ],
  "call": {
    "method": "solve",
    "args": {
      "task": {
        "type": "TurnstileTokenProxyLess",
        "websiteURL": "https://example.com/login",
        "websiteKey": "0x4AAAAAAAexample",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36"
      }
    }
  },
  "expect": {
    "sleeps": [],
    "lastTaskId": "tsk_4f7a9c1e2b8d3a6f5c0e9d21",
    "outcome": {
      "error": {
        "type": "TaskFailedError",
        "operation": "getTaskResult",
        "code": "ERROR_FAILED",
        "retryable": false,
        "taskId": "tsk_4f7a9c1e2b8d3a6f5c0e9d21",
        "supportedUserAgents": [],
        "messageIncludes": [
          "ERROR_FAILED",
          "Captcha could not be solved.",
          "tsk_4f7a9c1e2b8d3a6f5c0e9d21"
        ]
      }
    }
  }
}
