{
  "area": "solve",
  "name": "solve-cancelled-after-sleep",
  "description": "Cancelling after the first sleep ends solve() with native cancellation; the taskId was already delivered.",
  "evidence": [
    "contract:docs/design.md §3 solve() semantics"
  ],
  "script": [
    {
      "expect": {
        "method": "POST",
        "path": "/createTask",
        "json": {
          "clientKey": "sur_00000000000000000000000000000000",
          "task": {
            "type": "TurnstileTokenProxyLess",
            "websiteURL": "https://example.com/login",
            "websiteKey": "0x4AAAAAAAexample",
            "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36"
          }
        },
        "noQuery": true
      },
      "respond": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "no-store"
        },
        "json": {
          "errorId": 0,
          "taskId": "tsk_4f7a9c1e2b8d3a6f5c0e9d21",
          "status": "idle"
        }
      }
    },
    {
      "expect": {
        "method": "POST",
        "path": "/getTaskResult",
        "json": {
          "clientKey": "sur_00000000000000000000000000000000",
          "taskId": "tsk_4f7a9c1e2b8d3a6f5c0e9d21"
        },
        "noQuery": true
      },
      "respond": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "no-store"
        },
        "json": {
          "errorId": 0,
          "status": "processing"
        }
      }
    }
  ],
  "call": {
    "method": "solve",
    "args": {
      "task": {
        "type": "TurnstileTokenProxyLess",
        "websiteURL": "https://example.com/login",
        "websiteKey": "0x4AAAAAAAexample",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36"
      }
    },
    "cancelAfterSleeps": 1
  },
  "expect": {
    "sleeps": [
      3000
    ],
    "lastTaskId": "tsk_4f7a9c1e2b8d3a6f5c0e9d21",
    "outcome": {
      "error": {
        "type": "Cancelled"
      }
    }
  }
}
