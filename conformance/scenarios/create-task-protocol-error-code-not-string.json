{
  "area": "create-task",
  "name": "create-task-protocol-error-code-not-string",
  "description": "errorId 1 with a non-string errorCode is a ProtocolError.",
  "evidence": [
    "contract:docs/design.md §3 Errors"
  ],
  "script": [
    {
      "expect": {
        "method": "POST",
        "path": "/createTask",
        "json": {
          "clientKey": "sur_00000000000000000000000000000000",
          "task": {
            "type": "TurnstileTokenProxyLess",
            "websiteURL": "https://example.com/login",
            "websiteKey": "0x4AAAAAAAexample",
            "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36"
          }
        },
        "noQuery": true
      },
      "respond": {
        "status": 200,
        "headers": {
          "content-type": "application/json",
          "cache-control": "no-store"
        },
        "json": {
          "errorId": 1,
          "errorCode": 5,
          "errorDescription": "x"
        }
      }
    }
  ],
  "call": {
    "method": "createTask",
    "args": {
      "task": {
        "type": "TurnstileTokenProxyLess",
        "websiteURL": "https://example.com/login",
        "websiteKey": "0x4AAAAAAAexample",
        "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/155.0.0.0 Safari/537.36"
      }
    }
  },
  "expect": {
    "sleeps": [],
    "outcome": {
      "error": {
        "operation": "createTask",
        "type": "ProtocolError"
      }
    }
  }
}
