        "json": {
          "success": true,
          "data": {
            "services": [
              {
                "id": 7,
                "slug": "turnstile",
                "display_name": "Cloudflare Turnstile",
                "price_per_request": "0.0006",
                "status": "active",
                "avg_latency_ms": null
              }
            ]
          }
        }
      }
    }
  ],
  "call": {
    "method": "listServices"
  },
  "expect": {
    "outcomeSubset": [
      {
        "pointer": "",
